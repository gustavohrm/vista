{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Vista",
  "version": "0.0.1",
  "identifier": "com.coden.vista",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vista",
        "width": 1200,
        "height": 800,
        "minWidth": 320,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
