{
  "name": "vista",
  "version": "0.0.1",
  "private": true,
  "author": "coden.agency",
  "type": "module",
  "scripts": {
    "build": "pnpm build:web && pnpm build:native",
    "build:native": "pnpm --filter=@vista/native build",
    "build:web": "pnpm --filter=@vista/web build",
    "deploy:web": "pnpm --filter=@vista/web deploy",
    "dev:native": "pnpm --filter=@vista/native dev:native",
    "dev:web": "pnpm --filter=@vista/web dev",
    "format:check": "oxfmt --check && prettier --check --log-level warn \"**/*.md\"",
    "format:fix": "oxfmt && prettier --write --log-level warn \"**/*.md\" && pnpm --filter=@vista/native format:rust:fix",
    "hooks:install": "node scripts/install-hooks.mjs",
    "labels": "node scripts/sync-labels.mjs",
    "lint:check": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "prepare": "node scripts/install-hooks.mjs",
    "test": "pnpm test:hooks && pnpm -r --if-present test",
    "test:hooks": "node --test scripts/git-hooks.test.mjs",
    "test:coverage": "pnpm -r --if-present test:coverage",
    "test:e2e": "pnpm --filter=@vista/web test:e2e",
    "test:watch": "pnpm -r --if-present test:watch",
    "typecheck": "pnpm -r --if-present typecheck",
    "verify": "pnpm verify:web && pnpm verify:rust",
    "verify:rust": "pnpm --filter=@vista/native format:rust:check && pnpm --filter=@vista/native lint:rust:check && pnpm --filter=@vista/native test:rust",
    "verify:web": "pnpm format:check && pnpm lint:check && pnpm typecheck && pnpm test && pnpm build:web && pnpm build:native"
  },
  "devDependencies": {
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "prettier": "catalog:"
  },
  "engines": {
    "node": ">=24.14.1 <25",
    "pnpm": "11.7.0"
  },
  "packageManager": "pnpm@11.7.0"
}
