{
  "name": "vista",
  "version": "0.0.1",
  "private": true,
  "author": "coden.agency",
  "type": "module",
  "scripts": {
    "build": "pnpm build:web && pnpm build:native",
    "build:native": "pnpm --filter=@vista/native build",
    "build:web": "pnpm --filter=@vista/web build",
    "deploy:web": "pnpm --filter=@vista/web run deploy",
    "dev:native": "pnpm --filter=@vista/native dev:native",
    "dev:web": "pnpm --filter=@vista/web dev",
    "format:check": "oxfmt --check && prettier --check --log-level warn \"**/*.md\"",
    "format:fix": "oxfmt && prettier --write --log-level warn \"**/*.md\" && pnpm --filter=@vista/native format:rust:fix",
    "labels": "node scripts/sync-labels.mjs",
    "lint:check": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "prepare": "git config core.hooksPath .githooks || echo Skipped git hook setup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm --filter=@vista/web test:e2e",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "versions:check": "node scripts/check-versions.mjs",
    "verify": "pnpm verify:web && pnpm verify:rust",
    "verify:rust": "pnpm --filter=@vista/native format:rust:check && pnpm --filter=@vista/native lint:rust:check",
    "verify:web": "pnpm versions:check && pnpm format:check && pnpm lint:check && pnpm typecheck && pnpm test && pnpm build:web && pnpm build:native"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.22.1 <25",
    "pnpm": ">=12.16.1 <13"
  },
  "packageManager": "pnpm@12.16.1"
}
