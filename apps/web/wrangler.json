{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vista",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-13",
  "routes": [{ "pattern": "vista.coden.dev", "custom_domain": true }],
  "assets": {
    "not_found_handling": "single-page-application",
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/releases/*", "/download/*"]
  },
  "r2_buckets": [
    {
      "binding": "RELEASES",
      "bucket_name": "vista-releases"
    }
  ]
}
